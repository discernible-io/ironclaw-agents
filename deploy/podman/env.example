# Runtime secrets for Podman HTTPS deploy.
# Copied once by ./ironclaw.sh init → ~/ironclaw-app/secrets/secrets.env (chmod 600).
# Do NOT commit secrets.env. Replace every CHANGE_ME before start.

# --- Deploy / ingress (host-only; also used by ironclaw.sh status) ---
IRONCLAW_DEPLOY_TIER=development
# Public hostname matching nginx server_name (development|main)
IRONCLAW_PUBLIC_HOST=ironclaw.dihola.io
# Host/pod published TLS port (development default 5443; main often 9443)
IRONCLAW_APP_PORT=5443

# --- Reborn serve (pod-internal; nginx terminates TLS) ---
IRONCLAW_REBORN_PROFILE=hosted-single-tenant-volume
IRONCLAW_REBORN_SERVE_HOST=127.0.0.1
IRONCLAW_REBORN_SERVE_PORT=3000
IRONCLAW_REBORN_HOME=/data/ironclaw-reborn
IRONCLAW_REBORN_LOG=info

# Must match the public HTTPS URL clients and future A2A peers use.
IRONCLAW_REBORN_WEBUI_BASE_URL=https://ironclaw.dihola.io:5443

# WebUI bearer token (generate: openssl rand -hex 32)
IRONCLAW_REBORN_WEBUI_TOKEN=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
IRONCLAW_REBORN_WEBUI_USER_ID=reborn-cli

# Optional: durable secrets master key for hosted profiles that encrypt at rest.
# Generate: openssl rand -base64 32
# IRONCLAW_REBORN_SECRET_MASTER_KEY=CHANGE_ME

# --- LLM ---
# Default Docker profile used NearAI; this deploy can use OpenRouter instead.
# Put the key in secrets.env and set [llm.default] in
# $IRONCLAW_REBORN_HOME/config.toml to provider_id = "openrouter".
OPENROUTER_API_KEY=CHANGE_ME
# OPENROUTER_MODEL=anthropic/claude-sonnet-4

# NearAI (only if config.toml provider_id = "nearai"):
# NEARAI_BASE_URL=https://cloud-api.near.ai
# NEARAI_API_KEY=CHANGE_ME

# --- Optional product / SSO (leave unset until needed) ---
# IRONCLAW_REBORN_SLACK_ENABLED=false
# IRONCLAW_REBORN_WEBUI_GOOGLE_CLIENT_ID=
# IRONCLAW_REBORN_WEBUI_GOOGLE_CLIENT_SECRET=
# IRONCLAW_REBORN_WEBUI_ALLOWED_EMAIL_DOMAINS=
# IRONCLAW_REBORN_GOOGLE_CLIENT_ID=
# IRONCLAW_REBORN_GOOGLE_CLIENT_SECRET=
# IRONCLAW_REBORN_GOOGLE_OAUTH_REDIRECT_URI=https://ironclaw.dihola.io:5443/api/reborn/product-auth/oauth/google/callback

# --- IdentyClaw (host helper sidecar — keys outside agent sandbox) ---
# Place gennearaccount JSON under secrets/near-credentials/ then:
#   ./ironclaw.sh identyclaw-init
#   ./ironclaw.sh identyclaw ensure-session
# IDENTYCLAW_BASE_URL=https://api.identyclaw.com
# IDENTYCLAW_NEAR_CONTRACT_ID=genaaaa-identyclaw-com.near
# NEAR_CONTRACT_ID=genaaaa-identyclaw-com.near
# Federated peers (comma-separated), same SR/CR family:
# IDENTYCLAW_API_ENDPOINTS=https://slc.discernible.io:8443
# Loopback helper (same Podman pod as reborn; do not publish via nginx):
# IDENTYCLAW_HELPER_HOST=127.0.0.1
# IDENTYCLAW_HELPER_PORT=3921
# IDENTYCLAW_HELPER_BASE=http://127.0.0.1:3921
# Set true to start the identyclaw helper container with the pod (default: start when near-credentials exist)
# IRONCLAW_IDENTYCLAW_HELPER=auto
